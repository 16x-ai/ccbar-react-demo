{
  "name": "ccbar-react-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node server/dev.mjs",
    "dev:vite": "vite",
    "token-server": "node server/token-server.js",
    "build": "tsc -b && vite build",
